pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

function _init()

    music(0)
    -- tick counter
    tick = 0

    -- score
    score = {
        value = 0,
        color = 7,
        flash = 10,
        ft = 0
    }

    dot = {
	-- radius
	r = 4,

	-- position
	x = 64,
	y = 20,

	-- movement per frame (in pixels)
	-- y goes down
	vx = 0,
	vy = 0,

	-- jump strength (more minus = higher)
	jump = -5,

	-- on the ground (only collision sets this)
	grounded = false,

	-- max speed (in pixels)
	top_speed = 2,

	-- slowdown while holding
	drag = .2,

	-- slowdown after letting go
	brake = .45,

	-- slowdown when turning
	turn = .5,

    -- short hop check
    short_hop = false,

    -- coyote time
    c_max = 5,

    -- color (7 = white)
    color = 7
    }

    -- set coyote timer
    dot.coyote = dot.c_max

    -- speed added per frame
    dot.accel = dot.top_speed * dot.drag

    -- width and height for anims
    dot.w, dot.h = dot.r*2, dot.r*2

    -- gravity per frame
    g = .3

    coins = {
        {x = 36, y = 72, offset = 0, r = 4},
        {x = 96, y = 40, offset = 11, r = 4},
        {x = 36, y = 16, offset = 23, r = 4}
    }

    parts = {}

    fx = {
        jump_smoke = {
            n = 6,
            col = 6,
            life = 12,
            sx = .3,
            dy = -1,
            sy = .8
        },

        land_dust = {
            n = 6,
            col = 6,
            life = 12,
            sx = 1,
            dy = -.1,
            sy = .1
        },

        coin_burst = {
            n = 8,
            col = 10,
            life = 8,
            sx = 1,
            dy = -.5,
            sy = .5
        },

        trail = {
            n = 1, sx = 0, dy = 0, sy = 0,
            life = 12,
            col = 13,          -- fallback
            ramp = {13, 5, 1},  -- bright to dark
            size = 4
        }
    }

    fx_on = true
    shake = 0
    freeze = 0
end

function _update60()
    if freeze > 0 then freeze -= 1; return end
    tick += 1

    if btnp(4) then fx_on = not(fx_on) end
	dot_movement()
	update_parts()
	for i=#coins,1,-1 do
	    local c = coins[i]
		if circ_circ_coll(dot, c) then
		    spawn_fx(c.x, c.y, fx.coin_burst)
		    deli(coins, i)
			if #coins == 0 and fx_on then freeze = 9; shake = 10 end
			sfx(1)
			score.value += 1
			score.ft = score.flash
		end
	end
	if score.ft > 0 then
		score.color = 10
		score.ft -= 1
	else
	    score.color = 7
	end
	screen_shake()
end

function _draw()
	cls(0)
	if freeze == 0 then
    	local ox = rnd(shake) - shake/2
        local oy = rnd(shake) - shake/2
        camera(ox, oy)
	end
    map(0,0,0,0,16,16)
    for i=1,#coins do
		draw_coin(coins[i])
	end
	draw_parts()
	draw_dot()
	camera(0,0)
	print("score: "..score.value, 84, 10, score.color)
	print("fx:"..tostr(fx_on), 84, 18, 7)
	if freeze > 6 then
	    --invert palette ("negative" flash)
		for i=0,15 do
		    pal(i, 15-i, 1)
		end
	else
	    pal()
	end
end

function dot_movement()

    -- 1. work out speed

    -- X
    local dir = 0
    if btn(0) then dir -= 1 end
    if btn(1) then dir += 1 end

    local d = dot.drag
    if dir == 0 then d = dot.brake end
    if dir * dot.vx < 0 then
        d = dot.turn
    end
    dot.vx -= dot.vx * d
    dot.vx += dir * dot.accel

    -- Y
    local grav = g
    if dot.vy > 0 then grav = g * 1.3 end
    if dot.vy < 0 and not(btn(5)) and dot.short_hop == false then
        dot.short_hop = true
        dot.vy /= 2
    end
    dot.vy += grav
    if dot.coyote > 0 and btnp(5) then
        sfx(0)
        spawn_fx(dot.x, dot.y + dot.r, fx.jump_smoke)
        dot.vy = dot.jump
        dot.coyote = 0
    end

    -- 2. move x
    local px = dot.x + dot.vx
    if circ_coll(px, dot.y, dot.r) then
        local step = sgn(dot.vx)
        while not circ_coll(dot.x + step, dot.y, dot.r) do
            dot.x += step
        end
        dot.vx = 0
    else
        dot.x = px
    end

    -- 3. move y
    local py = dot.y + dot.vy
    local fall_speed = dot.vy
    if circ_coll(dot.x, py, dot.r) then
        local step = sgn(dot.vy)
        while not circ_coll(dot.x, dot.y + step, dot.r) do
            dot.y += step
        end
        dot.vy = 0
    else
        dot.y = py
    end

    -- 4. ground check
    local was = dot.grounded
    dot.grounded = circ_coll(dot.x, dot.y + 1, dot.r)
    if dot.grounded and not(was) then
        sfx(2)
        if fx_on then
            if fall_speed > 6 then shake = 6 end
            dot.h, dot.w = 5, 11
        end
        spawn_fx(dot.x, dot.y + dot.r, fx.land_dust)
    end
    if dot.grounded then
        dot.short_hop = false
        dot.coyote = dot.c_max
    else
        dot.coyote -= 1
    end

    -- 5. shape
    local target_w, target_h = dot.w, dot.h
    local ease = .3
    if dot.grounded == true or not(fx_on) then
        target_w = 2*dot.r
        target_h = 2*dot.r
    else
        local stretch = min(3,abs(dot.vy))
        target_w = 2*dot.r - stretch
        target_h = 2*dot.r + stretch
    end
    dot.w += (target_w - dot.w) * ease
    dot.h += (target_h - dot.h) * ease
    spawn_fx(dot.x, dot.y, fx.trail)
end

function is_wall(px, py)
    local tx = flr(px / 8)
    local ty = flr(py / 8)
    return fget(mget(tx, ty), 0)
end

function circ_coll(x, y, r)
    return (is_wall(x + r, y)
    or is_wall(x - r, y)
    or is_wall(x, y + r)
    or is_wall(x, y - r))
end

function circ_circ_coll(c1, c2)
    local dx,dy,rsum = c2.x-c1.x, c2.y-c1.y, c1.r+c2.r
    return dx*dx+dy*dy <= rsum*rsum
end

function draw_coin(c)
    local w = max(1,abs(cos((tick  + c.offset) / 80)) * 8)
    local x0 = c.x - (w / 2)
    local x1 = c.x + (w / 2)
    local y0 = (sin((tick  + c.offset) / 80) * 2) + c.y - c.r
    local y1 = (sin((tick  + c.offset) / 80) * 2) + c.y + c.r
    ovalfill(x0, y0, x1, y1, 10)
end

function spawn_fx(x, y, fx)
    if not(fx_on) then return end
    for i=1,fx.n do
        local l = (rnd(.5) + .5) * fx.life
        local part = {
            x = x,
            y = y,
            dx = rnd(2*fx.sx) - fx.sx,
            dy = rnd(2*fx.sy) - fx.sy + fx.dy,
            life = l,
            col = fx.col,
            ramp = fx.ramp,
            max_life = l,
            size = fx.size
        }
        add(parts, part)
    end
end

function update_parts()
	for i=#parts,1,-1 do
	    local p = parts[i]
	    if p.life > 0 then
    	    p.x += p.dx
    		p.y += p.dy
            p.life -= 1
        else
            deli(parts, i)
		end
	end
end

function draw_parts()
    for i=1,#parts do
        local p = parts[i]
        local c = p.col
        local s = p.size
        if p.ramp then
            local used = 1 - p.life / p.max_life
            local index = min(flr(used * #p.ramp) + 1, #p.ramp)
            c = p.ramp[index]
        end
        if s then
            local r = s * p.life / p.max_life
            circfill(p.x, p.y, r, c)
        else
            pset(p.x, p.y, c)
        end

    end
end

function draw_dot()
    local x0 = dot.x - dot.w/2
    local x1 = dot.x + dot.w/2
    local y1 = dot.y + dot.r
    local y0 = y1 - dot.h
    ovalfill(x0, y0, x1, y1, dot.color)
end

function screen_shake()
    if shake > 0 then
        if shake < 0.3 then
            shake = 0
        else
            shake = shake * 0.8
        end
    end
end

